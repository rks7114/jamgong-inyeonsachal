# 잼공인연사찰 자동화 환경변수 예시
# 실제 값을 채운 뒤 automation/.env 로 복사하세요. (.env 는 .gitignore 대상)
# cp automation/.env.example automation/.env

# --- Threads(스레드) 자동 발행용 ---
# Threads Graph API 사용자 ID와 장기 액세스 토큰
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Q&A 에이전트 LLM 다듬기(선택) ---
# 미설정 시 지식베이스(faq.json) 답변만 사용
ANTHROPIC_API_KEY=
QA_MODEL=claude-opus-4-8
